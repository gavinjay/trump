{
  "rules": {
    "matchmaking": {
      "queue": {
        "$gameMode": {
          ".read": "auth != null",
          "$entryId": {
            ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['userId', 'playerName', 'timestamp', 'status']) && newData.child('userId').val() === auth.uid",
            "playerName": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "status": { ".validate": "newData.val() === 'waiting' || newData.val() === 'matched'" }
          }
        }
      }
    },
    "games": {
      "$gameId": {
        ".read": "auth != null && (data.child('players/south/userId').val() === auth.uid || data.child('players/north/userId').val() === auth.uid || data.child('players/east/userId').val() === auth.uid || data.child('players/west/userId').val() === auth.uid)",
        ".write": "auth != null && (!data.exists() || data.child('players/south/userId').val() === auth.uid || data.child('players/north/userId').val() === auth.uid || data.child('players/east/userId').val() === auth.uid || data.child('players/west/userId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['players', 'gameState'])"
      }
    },
    "invites": {
      "$userId": {
        ".read": "auth != null && $userId === auth.uid",
        "$inviteId": {
          ".write": "auth != null && (newData.child('fromUserId').val() === auth.uid || $userId === auth.uid)",
          ".validate": "newData.hasChildren(['gameId', 'fromUserId', 'fromPlayerName', 'timestamp', 'status']) && newData.child('fromUserId').val() === auth.uid",
          "fromPlayerName": { ".validate": "newData.isString() && newData.val().length <= 20" }
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
